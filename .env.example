# Neon Postgres
# Obtain a connection string for your database from the Connection Details widget on the Neon Dashboard.
DATABASE_URL="<postgres://user:pass@host/db>"

# Better Auth
# Generate an auth secret using `openssl rand -base64 32`
BETTER_AUTH_SECRET="<generated-secret-at-least-32-chars>"
# Set the base URL of your application. Set to your production Vercel URL for production.
BETTER_AUTH_URL="http://localhost:3000"

# Testing
# The test suite runs against a DEDICATED test database, never the dev/prod database.
# On Neon: create a separate branch (e.g. "test") and paste its connection string here.
# NOTE: TEST_DATABASE_URL is read from .env.test (gitignored), not from .env.
TEST_DATABASE_URL="<postgres://user:pass@host/db>"
# Fresh secret for the test environment, independent from the dev/prod secret.
TEST_BETTER_AUTH_SECRET="<generated-secret-at-least-32-chars>"
# Playwright boots the dev server on port 3100 so it never clashes with a local dev server on 3000.
TEST_BETTER_AUTH_URL="http://localhost:3100"
# No test sends email, but the Resend client throws at import without a key.
# Use a clearly-fake placeholder in .env.test (never a real key).
TEST_RESEND_API_KEY="re_test_00000000000000000000000000000000"
